# ============================================================
# POST-QUANTUM HYBRID ENCRYPTER — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
PQHE_ENV=development          # development | staging | production
PQHE_DEBUG=false
PQHE_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Key Storage ---
PQHE_KEYS_DIR=./keys
PQHE_KEY_FILE_PERMISSIONS=0o600

# --- Logging ---
PQHE_LOG_DIR=./logs
PQHE_LOG_FORMAT=json          # json | console
PQHE_LOG_ROTATION_MB=10
PQHE_LOG_RETENTION_DAYS=30

# --- Cryptographic Parameters (do not change unless you know what you are doing) ---
PQHE_KEM_ALGORITHM=Kyber768   # ML-KEM-768 via liboqs alias
PQHE_HKDF_HASH=SHA256
PQHE_HKDF_LENGTH=32
PQHE_AES_KEY_SIZE=32          # 256-bit
PQHE_AES_TAG_LENGTH=16

# --- Security ---
PQHE_WIPE_SECRETS_ON_EXIT=true
